<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ComboBox?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.GuidancePlanningController" prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/guidance.css">
    <BorderPane>
        <top>
            <Text id="title" BorderPane.alignment="TOP_CENTER" text="Phase 1: Planning"/>
        </top>
        <center>
            <VBox spacing="20" alignment="CENTER">
                <HBox spacing="10"  alignment="CENTER">
                    <Button fx:id="startVisualization" text="Start Visualization" onAction="#onStartVisualizationClicked"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER" >
                    <ToggleButton fx:id="xyPlane" text="XY-Plane" onAction="#onXYClicked"/>
                    <ToggleButton fx:id="zxPlane" text="ZX-Plane" onAction="#onZXClicked"/>
                    <ToggleButton fx:id="yzPlane" text="YZ-Plane" onAction="#onYZClicked"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER">
                    <ComboBox fx:id="pathComboBox" id="comboBox" prefWidth="200"/>
                </HBox>
            </VBox>
        </center>
        <bottom>
        </bottom>
    </BorderPane>
</StackPane>